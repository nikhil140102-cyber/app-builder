# Copy this file to ".env" (Windows: copy .env.example .env) and fill in your values.
# Restart the builder after changing it.

# ---- Accounts and cloud saving (Supabase) ----
# When both values are set, users sign in and their apps are saved in Supabase.
# Leave them empty to save apps as files on this computer instead.
# Find them in Supabase → Project Settings → API Keys. NEVER put the secret / service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Where apps are saved when Supabase is not used ----
#   (empty)  = JSON files in ./data/projects
#   browser  = this browser only (for static hosting)
#   local    = files, even if Supabase keys are set above
NEXT_PUBLIC_STORAGE=

# ---- "Save to my computer" export folder (optional) ----
# Default: the "exports" folder inside this builder folder. Example: C:\projects\apps
EXPORT_DIR=
